; ============================================================
; npm / pnpm / yarn(1.x) 通用加速配置
; 用法：备份原文件后整体替换 %USERPROFILE%\.npmrc
; ============================================================

; ---------- 1. 公共包：国内镜像 ----------
registry=https://registry.npmmirror.com

; ---------- 2. 私有包：内网 Nexus，按 scope 绑定 ----------

; ---------- 3. 原生模块 / 预编译二进制：绕开 GitHub Releases ----------
; node-gyp 编译要下的 headers
disturl=https://npmmirror.com/mirrors/node
; Electron 运行时与 electron-builder 工具链
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
; 老版本 node-sass / sharp / canvas 的预编译包
sass_binary_site=https://npmmirror.com/mirrors/node-sass
sharp_binary_host=https://npmmirror.com/mirrors/sharp
canvas_binary_host_mirror=https://npmmirror.com/mirrors/node-canvas-prebuilt

; ---------- 4. 网络鲁棒性：慢网/抖动时别一次失败就崩 ----------
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=60000

; ---------- 5. 其他 ----------
email=mr.alaia@qq.com
